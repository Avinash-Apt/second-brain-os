{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git check-ignore:*)",
      "Bash(wc:*)",
      "Bash(obsidian:*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/Resources/ops/vault-sync.sh\" pull-only --quiet",
            "async": true,
            "timeout": 60,
            "statusMessage": "Pulling vault from GitHub"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/Resources/ops/vault-sync.sh\" --quiet",
            "async": true,
            "timeout": 120,
            "statusMessage": "Syncing vault to GitHub"
          }
        ]
      }
    ]
  }
}
